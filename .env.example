DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require
SECRET_KEY=generate-a-strong-random-secret-key
ENV=development
TESTING=false  # Set to true for test database

# Session
SESSION_COOKIE_NAME=staffplan_session
SESSION_MAX_AGE_SECONDS=86400

# MS365 OAuth (optional — configure for production SSO)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Business defaults
DEFAULT_BENCH_ROLLOFF_DAYS=7
BULK_UPLOAD_MAX_ROWS=8000
CSV_MAX_FILE_SIZE_MB=10

# Licensing (required for license key generation)
LICENSE_SIGNING_KEY=generate-a-strong-random-key-for-license-signing

# Email (SMTP) - Zoho
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=verify@skilled.in
SMTP_PASSWORD=your-zoho-app-password
SMTP_FROM_EMAIL=verify@skilled.in
SMTP_USE_TLS=true
